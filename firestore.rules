rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPlatformAdmin() {
      return isAuthenticated() &&
        (getUserData().role == 'admin' ||
         (request.auth.token.email == "halvareznet@gmail.com" && request.auth.token.email_verified == true));
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId);
    }

    function isOrgMember(orgId) {
      return isAuthenticated()
        && exists(memberPath(orgId))
        && get(memberPath(orgId)).data.activo == true
        && get(memberPath(orgId)).data.user_id == request.auth.uid
        && get(memberPath(orgId)).data.organization_id == orgId;
    }

    function orgMemberRole(orgId) {
      return get(memberPath(orgId)).data.role;
    }

    function canReadOrg(orgId) {
      return isOrgMember(orgId);
    }

    function canWriteOrgData(orgId) {
      return isOrgMember(orgId)
        && orgMemberRole(orgId) in ['owner', 'admin', 'contador'];
    }

    function canManageOrg(orgId) {
      return isOrgMember(orgId)
        && orgMemberRole(orgId) in ['owner', 'admin'];
    }

    /** E8.2: cambios de rol sin auto-escalamiento / sin promover a owner. */
    function memberRoleChangeAllowed(orgId) {
      return request.resource.data.role == resource.data.role
        || (
          resource.data.role != 'owner'
          && request.resource.data.role in ['admin', 'contador', 'viewer']
          && (
            (orgMemberRole(orgId) == 'owner'
              && request.resource.data.role in ['admin', 'contador', 'viewer'])
            || (orgMemberRole(orgId) == 'admin'
              && request.resource.data.role in ['contador', 'viewer'])
          )
        );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'nombre', 'activo']) &&
             data.role in ['admin', 'contador', 'auxiliar', 'vendedor', 'director'] &&
             data.email is string &&
             data.nombre is string && data.nombre.size() < 100 &&
             data.activo is bool &&
             (!('periodos_cerrados' in data) || (data.periodos_cerrados is list && data.periodos_cerrados.size() < 64)) &&
             (!('cuentas_contables' in data) || (data.cuentas_contables is list && data.cuentas_contables.size() < 200)) &&
             (!('empresa_nombre' in data) || (data.empresa_nombre is string && data.empresa_nombre.size() < 300)) &&
             (!('empresa_rfc' in data) || (data.empresa_rfc is string && data.empresa_rfc.size() < 20)) &&
             (!('active_organization_id' in data) || data.active_organization_id is string);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['organization_id', 'usuario_id', 'tipo', 'monto', 'fecha', 'status']) &&
             data.tipo in ['ingreso', 'egreso'] &&
             data.status in ['pendiente', 'conciliado', 'revisión', 'rechazado'] &&
             data.monto is number &&
             data.organization_id is string &&
             data.usuario_id is string;
    }

    function isValidRecurringTransaction(data) {
      return data.keys().hasAll(['organization_id', 'usuario_id', 'tipo', 'monto', 'frecuencia', 'proxima_ejecucion', 'condicion_fin', 'activa']) &&
             data.tipo in ['ingreso', 'egreso'] &&
             data.frecuencia in ['diaria', 'semanal', 'mensual', 'anual'] &&
             data.condicion_fin in ['nunca', 'ocurrencias', 'fecha'] &&
             data.monto is number &&
             data.usuario_id is string &&
             data.organization_id is string &&
             data.activa is bool;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isPlatformAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isPlatformAdmin()) &&
                    (request.resource.data.role == resource.data.role || isPlatformAdmin());
      allow delete: if isPlatformAdmin();
    }

    match /organizations/{orgId} {
      allow read: if canReadOrg(orgId);
      allow create: if isAuthenticated()
        && request.resource.data.creado_por == request.auth.uid;
      allow update: if canManageOrg(orgId);
      allow delete: if canManageOrg(orgId) && orgMemberRole(orgId) == 'owner';
    }

    match /organization_members/{memberId} {
      allow read: if isAuthenticated()
        && (resource.data.user_id == request.auth.uid
            || isOrgMember(resource.data.organization_id));
      // Solo bootstrap self-owner (E8.1). Invitados: Admin SDK vía acceptOrgInvite.
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.role == 'owner'
        && memberId == request.auth.uid + '_' + request.resource.data.organization_id;
      allow update: if
        (
          canManageOrg(resource.data.organization_id)
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.organization_id == resource.data.organization_id
          && memberRoleChangeAllowed(resource.data.organization_id)
        )
        || (
          resource.data.user_id == request.auth.uid
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.role == resource.data.role
          && request.resource.data.organization_id == resource.data.organization_id
        );
      allow delete: if canManageOrg(resource.data.organization_id)
        || resource.data.user_id == request.auth.uid;
    }

    // E8.2: escrituras solo Cloud Functions (Admin SDK). Lectura managers.
    match /organization_invitations/{inviteId} {
      allow read: if canManageOrg(resource.data.organization_id);
      allow create, update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && canReadOrg(resource.data.organization_id);
      allow create: if isAuthenticated()
        && isValidTransaction(request.resource.data)
        && request.resource.data.usuario_id == request.auth.uid
        && canWriteOrgData(request.resource.data.organization_id);
      allow update: if isAuthenticated()
        && isValidTransaction(request.resource.data)
        && request.resource.data.organization_id == resource.data.organization_id
        && canWriteOrgData(resource.data.organization_id);
      allow delete: if canManageOrg(resource.data.organization_id);
    }

    match /recurring_transactions/{recurringId} {
      allow read: if isAuthenticated() && canReadOrg(resource.data.organization_id);
      allow create: if isAuthenticated()
        && isValidRecurringTransaction(request.resource.data)
        && request.resource.data.usuario_id == request.auth.uid
        && canWriteOrgData(request.resource.data.organization_id);
      allow update: if isAuthenticated()
        && isValidRecurringTransaction(request.resource.data)
        && request.resource.data.organization_id == resource.data.organization_id
        && canWriteOrgData(resource.data.organization_id);
      allow delete: if canManageOrg(resource.data.organization_id);
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.usuario_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.usuario_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if isAuthenticated() && canReadOrg(resource.data.organization_id);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['usuario_id', 'organization_id', 'codigo', 'descripcion'])
        && request.resource.data.usuario_id == request.auth.uid
        && canWriteOrgData(request.resource.data.organization_id)
        && request.resource.data.codigo is string
        && request.resource.data.descripcion is string;
      allow update, delete: if isAuthenticated()
        && canWriteOrgData(resource.data.organization_id)
        && request.resource.data.organization_id == resource.data.organization_id;
    }

    match /inventory_movements/{movId} {
      allow read: if isAuthenticated() && canReadOrg(resource.data.organization_id);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['usuario_id', 'organization_id', 'product_id', 'tipo', 'cantidad', 'fecha'])
        && request.resource.data.usuario_id == request.auth.uid
        && canWriteOrgData(request.resource.data.organization_id)
        && request.resource.data.tipo in ['entrada', 'salida', 'ajuste']
        && request.resource.data.cantidad is number
        && request.resource.data.product_id is string;
      allow update, delete: if isAuthenticated()
        && canWriteOrgData(resource.data.organization_id)
        && request.resource.data.organization_id == resource.data.organization_id;
    }


    match /bank_movements/{movementId} {
      allow read: if isAuthenticated() && canReadOrg(resource.data.organization_id);
      allow create: if isAuthenticated()
        && request.resource.data.usuario_id == request.auth.uid
        && canWriteOrgData(request.resource.data.organization_id);
      allow update, delete: if isAuthenticated()
        && canWriteOrgData(resource.data.organization_id)
        && request.resource.data.organization_id == resource.data.organization_id;
    }

    match /bank_allocations/{allocationId} {
      allow read: if isAuthenticated() && canReadOrg(resource.data.organization_id);
      allow create: if isAuthenticated()
        && request.resource.data.usuario_id == request.auth.uid
        && canWriteOrgData(request.resource.data.organization_id);
      allow update, delete: if isAuthenticated()
        && canWriteOrgData(resource.data.organization_id)
        && request.resource.data.organization_id == resource.data.organization_id;
    }

    match /test/connection {
      allow read: if true;
    }

    match /sat_credentials/{orgId} {
      allow read, write: if false;
    }

    match /sat_download_jobs/{jobId} {
      allow read: if isAuthenticated()
        && resource.data.usuario_id == request.auth.uid
        && (!('organization_id' in resource.data) || canReadOrg(resource.data.organization_id));
      allow write: if false;
    }
  }
}
