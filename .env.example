# Firebase configuration (Vite — prefijo VITE_)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Groq — requerido para clasificación, batch CFDI e insights (Fase 1)
# Inyectada en build por vite.config.ts como process.env.GROQ_API_KEY
GROQ_API_KEY=
# Opcional (default en src/config/aiModels.ts)
GROQ_MODEL=

# Gemini — opcional / residual; NO es fallback de clasificación en Fase 1
GEMINI_API_KEY=
GEMINI_MODEL=

# App URL (opcional)
VITE_APP_URL=

# --- E6.2 Descarga SAT (backend Cloud Functions) ---
# Provider frontend: mock (default, E6.1) | sat_ws (callables E6.2)
VITE_SAT_PROVIDER=mock
# Región de Cloud Functions (debe coincidir con setGlobalOptions)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# SOLO backend / Firebase Functions secrets (NUNCA en Vite / Vercel frontend):
# FIEL cifrada con AES-256-GCM; master key 32 bytes en base64.
# En prod: Firebase Secret Manager → SAT_FIEL_MASTER_KEY
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SAT_FIEL_MASTER_KEY=
# MockWs (default) | real = Nodecfdi SOAP al SAT (requiere FIEL en sat_credentials)
# SAT_WS_MODE=mock
# Deuda E6.3: migrar envelope a Cloud KMS; retenciones CFDI = futuro.
# Staging manual: docs/SAT_STAGING.md
