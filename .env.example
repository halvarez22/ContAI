# Firebase configuration (Vite — prefijo VITE_)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Groq — requerido para clasificación, batch CFDI e insights (Fase 1)
# Inyectada en build por vite.config.ts como process.env.GROQ_API_KEY
GROQ_API_KEY=
# Opcional (default en src/config/aiModels.ts)
GROQ_MODEL=

# Gemini — opcional / residual; NO es fallback de clasificación en Fase 1
GEMINI_API_KEY=
GEMINI_MODEL=

# App URL (opcional)
VITE_APP_URL=

# --- E6.2 Descarga SAT real (NO usar en E6.1 mock) ---
# La FIEL/CSD NUNCA debe vivir en el frontend Vite.
# Estas vars serán consumidas solo por un backend/Cloud Function:
# SAT_API_BASE_URL=
# SAT_DOWNLOAD_ENABLED=false
